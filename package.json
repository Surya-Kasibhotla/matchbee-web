{
  "name": "matchbee-web",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "MatchBee website: Next.js pages (static export) on Cloudflare Workers. The API is the separate matchbee-api backend.",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build && node scripts/postbuild.ts",
    "start": "node scripts/serve.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.ts",
    "deploy": "npm run build && wrangler deploy",
    "preview": "npm run build && wrangler versions upload"
  },
  "dependencies": {
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "wrangler": "4.147.0"
  },
  "license": "UNLICENSED"
}
